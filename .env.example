# Optional process environment overrides. Never commit a filled-in copy.
# init generates a private secrets.env; you do not need to invent a token.
# LAZYFISH_CONFIG=/absolute/path/to/config.toml
# LAZYFISH_WORKSPACE=/absolute/path/to/projects
# LAZYFISH_DATA_DIR=/absolute/path/to/data
# LAZYFISH_HOST=127.0.0.1
# LAZYFISH_PORT=3210
# LAZYFISH_CODEX_BIN=/absolute/path/to/codex
# CODEX_HOME=/absolute/path/to/codex-state
# LAZYFISH_TOKEN=your-own-random-token-with-at-least-32-characters
# HTTPS_PROXY=http://proxy.example:3128
# HTTP_PROXY=http://proxy.example:3128
# NO_PROXY=localhost,127.0.0.1,::1
# OPENAI_API_KEY=configure-only-if-your-native-Codex-setup-needs-it
# No proxy or API key is enabled by default. Existing CLI authentication is reused.
